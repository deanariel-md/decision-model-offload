# Copy to .env and fill in the keys for the systems you run. Never commit .env.
# OpenRouter: Jev and every chatbot except the Hugging Face pair.
OPENROUTER_API_KEY=
# Hugging Face router: MedGemma and Gemma.
HF_TOKEN=
# Optional: TypeSafe's own endpoint for Jev (JevClient transport "typesafe_direct").
TYPESAFE_API_KEY=
